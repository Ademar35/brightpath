    {
      "id": "b1w1d4",
      "day": 4,
      "kind": "conversa",
      "title": "A vizinha",
      "subtitle": "Talk to Dona Rosa, your neighbour. Choose your words.",
      "minutes": 8,
      "activities": [
        {
          "type": "card",
          "id": "w1d4-respeito",
          "title": "Respeito: talking to elders",
          "body": "In Angola, an older woman is often called Dona (Dona Rosa) or mais velha. An older man is o senhor or mais velho. Greet elders first and use você or o senhor / a senhora, never tu."
        },
        {
          "type": "branch",
          "id": "w1d4-branch",
          "title": "21:00. Dona Rosa is at her door.",
          "who": "Dona Rosa",
          "steps": [
            {
              "npc": "Boa noite! Tudo bem?",
              "en": "Good evening! All good?",
              "options": [
                { "text": "Boa noite, Dona Rosa! Tudo bem, obrigado.", "ok": true, "feedback": "Perfect. Night, so boa noite, and you used Dona. Very respectful." },
                { "text": "Bom dia! Tudo bem.", "ok": false, "feedback": "It's 21:00. After dark we say boa noite." },
                { "text": "Tchau!", "ok": false, "feedback": "Tchau is for leaving. You just arrived." }
              ]
            },
            {
              "npc": "Você é novo no bairro?",
              "en": "Are you new in the neighbourhood?",
              "options": [
                { "text": "Sim, eu és novo.", "ok": false, "feedback": "With eu we use sou: eu sou." },
                { "text": "Sim, sou novo. Sou estudante de português.", "ok": true, "feedback": "Great. Eu sou → sou. You can drop eu: Portuguese verbs already say who." },
                { "text": "Sim, nós é novo.", "ok": false, "feedback": "Nós goes with somos, and here you're talking about yourself: sou." }
              ]
            },
            {
              "npc": "Eu sou a Rosa. Sou professora reformada.",
              "en": "I'm Rosa. I'm a retired teacher.",
              "options": [
                { "text": "Olá, Rosa! Tu és fixe.", "ok": false, "feedback": "Too casual for an elder. Tu and \"fixe\" (cool) are for friends." },
                { "text": "Muito prazer, Dona Rosa!", "ok": true, "feedback": "Muito prazer + Dona: warm and respectful." },
                { "text": "Boa tarde, professora.", "ok": false, "feedback": "Nice respect, but it's night: boa noite." }
              ]
            },
            {
              "npc": "Hoje é sexta-feira. Amanhã é...?",
              "en": "Today is Friday. Tomorrow is...?",
              "options": [
                { "text": "Amanhã é quinta-feira.", "ok": false, "feedback": "Quinta-feira is Thursday, the day before." },
                { "text": "Amanhã é domingo.", "ok": false, "feedback": "Close. Domingo comes after sábado." },
                { "text": "Amanhã é sábado. Fim de semana!", "ok": true, "feedback": "Sábado. Fim de semana, finally." }
              ]
            },
            {
              "npc": "Bem, vou dormir. Boa noite!",
              "en": "Well, I'm going to sleep. Good night!",
              "options": [
                { "text": "Boa noite! Até amanhã!", "ok": true, "feedback": "Boa noite works for hello and goodbye at night. Até amanhã = see you tomorrow." },
                { "text": "Olá!", "ok": false, "feedback": "Olá is hello. She is leaving." },
                { "text": "Bom dia!", "ok": false, "feedback": "Bom dia is for the morning." }
              ]
            }
          ]
        },
        { "type": "repeat", "id": "w1d4-r1", "pt": "Boa noite, Dona Rosa! Até amanhã!", "en": "Good night, Dona Rosa! See you tomorrow!" }
      ]
    },
