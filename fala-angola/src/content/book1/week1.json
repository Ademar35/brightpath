{
  "id": "b1w1",
  "number": 1,
  "unit": "Unidade 1",
  "title": "Olá! Eu sou a Isa!",
  "titleEn": "Hello! I'm Isa!",
  "tagline": "You just landed in Luanda. Isa is your guide. Learn to greet anyone, any time of day.",
  "grammar": ["Verbo ser", "Pronomes pessoais", "Género (o / a)"],
  "vocabulary": ["Saudações e despedidas", "Números 0 a 10", "Dias da semana"],
  "sounds": ["-ão"],
  "mission": "Bom dia, Luanda: get through a full day of greetings, from the morning market to your neighbour at night.",
  "lessons": [
    {
      "id": "b1w1d1",
      "day": 1,
      "kind": "cena",
      "title": "Chegada",
      "subtitle": "Meet Isa. Guess before you learn.",
      "minutes": 8,
      "activities": [
        {
          "type": "choice",
          "id": "w1d1-pre1",
          "question": "Guess first. It is 8 o'clock in the morning. People in Luanda say...",
          "options": ["Bom dia", "Boa noite", "Tchau"],
          "answer": 0,
          "explain": "Bom dia = good morning. Guessing first, even wrongly, helps you remember the answer.",
          "say": "Bom dia"
        },
        {
          "type": "scene",
          "id": "w1d1-scene",
          "title": "Aeroporto, 08:10",
          "setting": "Arrivals hall, Luanda. Isa is holding a sign with your name.",
          "lines": [
            { "who": "Isa", "pt": "Olá! Bom dia! Eu sou a Isa.", "en": "Hi! Good morning! I'm Isa." },
            { "who": "Você", "pt": "Bom dia! Eu sou o Tom.", "en": "Good morning! I'm Tom." },
            { "who": "Isa", "pt": "Muito prazer, Tom! Eu sou professora. Sou de Luanda.", "en": "Very nice to meet you, Tom! I'm a teacher. I'm from Luanda." },
            { "who": "Você", "pt": "O prazer é todo meu. Eu sou estudante de português.", "en": "The pleasure is all mine. I'm a student of Portuguese." },
            { "who": "Isa", "pt": "Hoje é segunda-feira. Bem-vindo a Angola!", "en": "Today is Monday. Welcome to Angola!" }
          ]
        },
        {
          "type": "choice",
          "id": "w1d1-c1",
          "question": "What does Isa do?",
          "options": ["Ela é professora.", "Ela é médica.", "Ela é estudante."],
          "answer": 0,
          "explain": "\"Eu sou professora\" = I am a teacher."
        },
        {
          "type": "choice",
          "id": "w1d1-c2",
          "question": "What day is it today?",
          "options": ["Sexta-feira", "Segunda-feira", "Domingo"],
          "answer": 1,
          "explain": "\"Hoje é segunda-feira\" = Today is Monday."
        },
        {
          "type": "truefalse",
          "id": "w1d1-tf1",
          "statement": "Isa é de Luanda.",
          "answer": true,
          "explain": "\"Sou de Luanda\" = I'm from Luanda."
        },
        {
          "type": "repeat",
          "id": "w1d1-r1",
          "pt": "Muito prazer!",
          "en": "Very nice to meet you!"
        }
      ]
    },
    {
      "id": "b1w1d2",
      "day": 2,
      "kind": "frases",
      "title": "Eu sou, tu és",
      "subtitle": "The verb ser, the days and the sound -ão.",
      "minutes": 12,
      "activities": [
        {
          "type": "card",
          "id": "w1d2-ser",
          "title": "Verbo SER (to be: who or what you are)",
          "speakPairs": true,
          "rows": [["Eu", "sou"], ["Tu", "és"], ["Você", "é"], ["Ele / Ela", "é"], ["Nós", "somos"], ["Vocês", "são"], ["Eles / Elas", "são"]],
          "note": "In Angola, use você or o senhor / a senhora with people you don't know and with elders. Tu is for friends and family."
        },
        { "type": "repeat", "id": "w1d2-r1", "pt": "Eu sou estudante.", "en": "I am a student." },
        { "type": "repeat", "id": "w1d2-r2", "pt": "Nós somos vizinhos.", "en": "We are neighbours." },
        {
          "type": "gap",
          "id": "w1d2-g1",
          "before": "Eu",
          "after": "motorista de táxi em Luanda.",
          "options": ["sou", "é", "somos"],
          "answer": "sou",
          "en": "I am a taxi driver in Luanda."
        },
        {
          "type": "gap",
          "id": "w1d2-g2",
          "before": "Ela",
          "after": "vendedora no mercado do Roque Santeiro.",
          "options": ["és", "é", "são"],
          "answer": "é",
          "en": "She is a seller at the Roque Santeiro market."
        },
        {
          "type": "gap",
          "id": "w1d2-g3",
          "before": "Nós",
          "after": "vizinhos aqui no bairro.",
          "options": ["somos", "sou", "são"],
          "answer": "somos",
          "en": "We are neighbours here in the neighbourhood."
        },
        {
          "type": "gap",
          "id": "w1d2-g4",
          "before": "Você",
          "after": "novo na cidade?",
          "options": ["és", "é", "sou"],
          "answer": "é",
          "en": "Are you new in the city?"
        },
        {
          "type": "gap",
          "id": "w1d2-g5",
          "before": "Eles",
          "after": "estudantes universitários.",
          "options": ["é", "somos", "são"],
          "answer": "são",
          "en": "They are university students."
        },
        {
          "type": "card",
          "id": "w1d2-gen",
          "title": "O ou A? Every noun is masculine or feminine",
          "rows": [["-o, -el, -al, -ol, -ul", "usually masculine", "o carro, o papel"], ["-a", "usually feminine", "a casa, a mesa"], ["Watch out", "o dia, o mapa", "end in -a but are masculine"]]
        },
        {
          "type": "gap",
          "id": "w1d2-g6",
          "before": "",
          "after": "enfermeira do hospital.",
          "options": ["A", "O"],
          "answer": "A",
          "en": "The nurse at the hospital."
        },
        {
          "type": "gap",
          "id": "w1d2-g7",
          "before": "",
          "after": "vizinho do bairro.",
          "options": ["A", "O"],
          "answer": "O",
          "en": "The neighbour (man) from the neighbourhood."
        },
        {
          "type": "card",
          "id": "w1d2-dias",
          "title": "Dias da semana",
          "rows": [["segunda-feira", "Monday"], ["terça-feira", "Tuesday"], ["quarta-feira", "Wednesday"], ["quinta-feira", "Thursday"], ["sexta-feira", "Friday"], ["sábado", "Saturday"], ["domingo", "Sunday"]],
          "note": "Sábado and domingo are the fim de semana (weekend). The week starts on segunda-feira."
        },
        {
          "type": "card",
          "id": "w1d2-ao",
          "title": "The sound -ão",
          "body": "Say \"ow\" (as in \"now\") through your nose. Pinch your nose while you say it: if it buzzes, you've got it.",
          "rows": [["pão", "bread"], ["irmão", "brother"], ["coração", "heart"], ["feijão", "beans"], ["estação", "station"], ["limão", "lemon"], ["mão", "hand"], ["camião", "lorry"]]
        },
        { "type": "repeat", "id": "w1d2-r3", "pt": "pão, mão, irmão", "en": "bread, hand, brother", "focus": "ão" },
        { "type": "repeat", "id": "w1d2-r4", "pt": "O meu irmão compra pão na estação.", "en": "My brother buys bread at the station.", "focus": "ão" }
      ]
    },
